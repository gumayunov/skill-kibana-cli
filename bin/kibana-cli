#!/usr/bin/env bash
if (( BASH_VERSINFO[0] < 4 )); then
  echo "kibana-cli: bash >= 4 required (found $BASH_VERSION)" >&2
  exit 1
fi
set -euo pipefail

CLI_NAME="kibana-cli"

print_help() {
cat <<'EOF'
kibana-cli — search logs in Elasticsearch via Kibana console proxy

Usage:
  kibana-cli [options]
  kibana-cli --list-indices
  kibana-cli --help

Options:
  --since <dur>         time window start as duration (default: 1h; examples: 30m, 2h, 1d)
  --to <dur>            time window end as duration (default: now)
  --at <ts>             time window start as absolute ISO8601 (overrides --since)
  --until <ts>          time window end as absolute ISO8601 (overrides --to)
  --namespace <name>    kubernetes_namespace_name (default: $KIBANACLI_DEFAULT_NAMESPACE)
  --service <name>      kubernetes_container_name (api, worker, mqtt-consumer, ...)
  --level <lvl>         log level (info|warning|error|...)
  --query <text>        best-match (multi_match) against event, log, message
  --phrase <text>       exact phrase (match_phrase) against event, log, message
  --filter <k>=<v>      term filter on arbitrary field (repeatable)
  --exclude <k>=<v>     must_not term on arbitrary field (repeatable)
  --filter-phrase <k>=<v>   match_phrase filter on arbitrary field (repeatable)
  --exclude-phrase <k>=<v>  must_not match_phrase on arbitrary field (repeatable)
  --gte <k>=<v>         range filter, k >= v on arbitrary field (repeatable)
  --lte <k>=<v>         range filter, k <= v on arbitrary field (repeatable)
  --body <file|->       use raw ES query body from file (or stdin); bypasses
                        all other filter flags
  --index <pattern>     ES index pattern (default: logstash-*)
  --limit <N>           max hits (default: 50)
  --max-len <N>         truncate output line to N chars (default: 1000; 0 = no truncate)
  -o short|full|json    output format (default: short)
  --list-indices        show indices
  --help                show this help

Env file — first match wins: $KIBANACLI_ENV, then .kibana-cli/env upwards
from cwd (per-project config), then ~/.config/kibana-cli/env:
  KIBANACLI_HOST (required)     e.g. https://logs.example.com
  KIBANACLI_AUTH                apikey (default) or cookie (SSO via kibana-cli-login)
  KIBANACLI_API_KEY             base64(id:api_key); required for apikey auth
  KIBANACLI_COOKIE_FILE         cookie file for cookie auth (default: <env dir>/cookie)
  KIBANACLI_DEFAULT_NAMESPACE   default --namespace value
  KIBANACLI_MESSAGE_FIELDS      fields searched by --query/--phrase and used as
                                the line body in short/full output, first
                                non-empty wins (default: event,log,message)
  KIBANACLI_CONTEXT_FIELDS      whitelist for the k=v tail in short output;
                                dotted paths address nested objects
                                (default: empty = all non-reserved fields)
EOF
}

die() { echo "$CLI_NAME: $*" >&2; exit 1; }

# Mirror of find_env_file/load_env in kibana-cli-get; keep synchronised.
find_env_file() {
  if [[ -n "${KIBANACLI_ENV:-}" ]]; then echo "$KIBANACLI_ENV"; return; fi
  local dir=$PWD
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.kibana-cli/env" ]]; then echo "$dir/.kibana-cli/env"; return; fi
    dir=$(dirname "$dir")
  done
  echo "$HOME/.config/kibana-cli/env"
}

load_env() {
  ENV_FILE=$(find_env_file)
  if [[ -n "${KIBANACLI_ENV:-}" && ! -r "$KIBANACLI_ENV" ]]; then
    die "env file not readable: $KIBANACLI_ENV"
  fi
  [[ -r "$ENV_FILE" ]] && { set -a; . "$ENV_FILE"; set +a; }
  [[ -n "${KIBANACLI_HOST:-}" ]] || die "no config: set KIBANACLI_HOST in $ENV_FILE (see README)"
  AUTH_MODE="${KIBANACLI_AUTH:-apikey}"
  case "$AUTH_MODE" in
    apikey)
      [[ -n "${KIBANACLI_API_KEY:-}" ]] || die "no config: set KIBANACLI_API_KEY in $ENV_FILE (see README)"
      ;;
    cookie)
      local cookie_file="${KIBANACLI_COOKIE_FILE:-$(dirname "$ENV_FILE")/cookie}"
      [[ -r "$cookie_file" ]] || die "no cookie: run bin/kibana-cli-login first ($cookie_file missing)"
      KIBANACLI_COOKIE=$(<"$cookie_file")
      ;;
    *) die "invalid KIBANACLI_AUTH: $AUTH_MODE (expected apikey or cookie)" ;;
  esac
}

# Mirror of proxy_request in kibana-cli-get; keep synchronised.
proxy_request() {
  # args: method, es_path_with_query, [body_file]
  local method=$1 es_path=$2 body=${3:-}
  local url="${KIBANACLI_HOST%/}/api/console/proxy?path=$(printf %s "$es_path" | jq -sRr @uri)&method=$method"
  local tmp http_code curl_rc
  tmp=$(mktemp)
  local -a args=(-sS -o "$tmp" -w '%{http_code}'
    -H "Authorization: ApiKey $KIBANACLI_API_KEY"
    -H 'kbn-xsrf: true' -H 'Content-Type: application/json')
  curl_rc=0
  if [[ -n "$body" ]]; then
    http_code=$(curl "${args[@]}" -X POST "$url" --data @"$body" 2>/dev/null) || curl_rc=$?
  else
    http_code=$(curl "${args[@]}" -X POST "$url" 2>/dev/null) || curl_rc=$?
  fi
  if (( curl_rc != 0 )) || [[ -z "$http_code" ]]; then
    http_code=000
  fi
  case "$http_code" in
    2??) cat "$tmp"; rm -f "$tmp" ;;
    401) rm -f "$tmp"; die "auth failed (401). Re-create API key per README." ;;
    403) rm -f "$tmp"; die "access denied (403). Check API-key role_descriptors permissions." ;;
    000) rm -f "$tmp"; die "network error: could not reach ${KIBANACLI_HOST%/}" ;;
    *)
      local snippet
      snippet=$(head -c 200 "$tmp" 2>/dev/null || true)
      rm -f "$tmp"
      die "ES returned HTTP $http_code: $snippet"
      ;;
  esac
}

# Mirror of _cookie_curl/ese_search in kibana-cli-get; keep synchronised.
# Cookie mode targets Kibana's internal async-search API (/internal/search/ese)
# instead of the console proxy: SSO users typically lack the `console` Kibana
# privilege, while this endpoint only needs Discover-level access.
_cookie_curl() {
  # args: out_file, url, [payload]; prints http_code (000 on transport error)
  local out=$1 url=$2 payload=${3:-}
  local -a args=(-sS -o "$out" -w '%{http_code}'
    -H "Cookie: $KIBANACLI_COOKIE" -H 'kbn-xsrf: true'
    -H 'x-elastic-internal-origin: Kibana' -H 'Content-Type: application/json')
  local http_code
  if [[ -n "$payload" ]]; then
    http_code=$(curl "${args[@]}" -X POST "$url" --data "$payload" 2>/dev/null) || http_code=000
  else
    http_code=$(curl "${args[@]}" "$url" 2>/dev/null) || http_code=000
  fi
  echo "${http_code:-000}"
}

_cookie_check() {
  # args: http_code, tmp_file; dies on any non-2xx
  local http_code=$1 tmp=$2
  case "$http_code" in
    2??) ;;
    302|401) rm -f "$tmp"; die "cookie expired or invalid — re-run bin/kibana-cli-login" ;;
    403) rm -f "$tmp"; die "access denied (403): your SSO user lacks Kibana privileges for this API" ;;
    000) rm -f "$tmp"; die "network error: could not reach ${KIBANACLI_HOST%/}" ;;
    *)
      local snippet
      snippet=$(head -c 200 "$tmp" 2>/dev/null || true)
      rm -f "$tmp"
      die "Kibana returned HTTP $http_code: $snippet"
      ;;
  esac
}

ese_search() {
  # args: index, body_file; prints the raw ES response (.rawResponse)
  local index=$1 body=$2
  local url="${KIBANACLI_HOST%/}/internal/search/ese"
  local tmp http_code payload id tries=0
  tmp=$(mktemp)
  # legacyHitsTotal=false keeps hits.total as {value, relation} like plain _search.
  payload=$(jq -c --arg index "$index" '{legacyHitsTotal: false, params: {index: $index, body: .}}' "$body")
  http_code=$(_cookie_curl "$tmp" "$url" "$payload")
  _cookie_check "$http_code" "$tmp"
  # Async search: poll by id until the cluster finishes.
  while [[ $(jq -r '.isRunning' "$tmp") == "true" ]]; do
    (( ++tries > 60 )) && { rm -f "$tmp"; die "async search still running after 60s — narrow the query"; }
    id=$(jq -r '.id' "$tmp")
    sleep 1
    http_code=$(_cookie_curl "$tmp" "$url/$id" '{"legacyHitsTotal":false}')
    _cookie_check "$http_code" "$tmp"
  done
  jq '.rawResponse' "$tmp"
  rm -f "$tmp"
}

cmd_list_indices() {
  load_env
  if [[ "$AUTH_MODE" == "cookie" ]]; then
    # _cat/indices needs the console privilege; list Kibana data views instead.
    local tmp http_code
    tmp=$(mktemp)
    http_code=$(_cookie_curl "$tmp" "${KIBANACLI_HOST%/}/api/data_views")
    _cookie_check "$http_code" "$tmp"
    jq -r '.data_view[].title' "$tmp" | sort -u
    rm -f "$tmp"
  else
    proxy_request GET "_cat/indices?v=true&s=store.size:desc"
  fi
}

build_query() {
  # Serialise list-arrays as JSON arrays for jq.
  local filters_json excludes_json gtes_json ltes_json pfilters_json pexcludes_json
  filters_json=$(jq -cn '$ARGS.positional' --args -- "${FILTERS[@]+"${FILTERS[@]}"}")
  excludes_json=$(jq -cn '$ARGS.positional' --args -- "${EXCLUDES[@]+"${EXCLUDES[@]}"}")
  gtes_json=$(jq -cn '$ARGS.positional' --args -- "${GTES[@]+"${GTES[@]}"}")
  ltes_json=$(jq -cn '$ARGS.positional' --args -- "${LTES[@]+"${LTES[@]}"}")
  pfilters_json=$(jq -cn '$ARGS.positional' --args -- "${PHRASE_FILTERS[@]+"${PHRASE_FILTERS[@]}"}")
  pexcludes_json=$(jq -cn '$ARGS.positional' --args -- "${PHRASE_EXCLUDES[@]+"${PHRASE_EXCLUDES[@]}"}")

  jq -n \
    --arg since "$SINCE" \
    --arg to "$TO" \
    --arg at "$AT" \
    --arg until_ts "$UNTIL" \
    --arg ns "$NAMESPACE" \
    --arg svc "$SERVICE" \
    --arg lvl "$LEVEL" \
    --arg q "$QUERY" \
    --arg phrase "$PHRASE" \
    --argjson filters "$filters_json" \
    --argjson excludes "$excludes_json" \
    --argjson gtes "$gtes_json" \
    --argjson ltes "$ltes_json" \
    --argjson pfilters "$pfilters_json" \
    --argjson pexcludes "$pexcludes_json" \
    --arg msg_fields "${KIBANACLI_MESSAGE_FIELDS:-event,log,message}" \
    --argjson size "$LIMIT" \
    '
    def mk_range:
      {"@timestamp": (
        (if $at != "" then {gte: $at} else {gte: ("now-" + $since)} end)
        + (if $until_ts != "" then {lte: $until_ts}
           elif $to != "" then {lte: ("now-" + $to)}
           else {} end)
      )};

    def parse_kv: split("=") as $p | {k: $p[0], v: ($p[1:] | join("="))};
    def to_terms: map(parse_kv | {term: ({"\(.k).keyword": .v})});
    def to_phrases: map(parse_kv | {match_phrase: ({"\(.k)": .v})});
    # Try numeric coercion so `status=500` becomes a JSON number; falls back to string.
    def coerce: (tonumber? // .);
    def to_ranges($op): map(parse_kv | {range: ({"\(.k)": ({($op): (.v | coerce)})})});

    {
      size: $size,
      sort: [{"@timestamp": "desc"}],
      query: {
        bool: (
          {filter: [{range: mk_range}]}
          | (if $ns  != "" then .filter += [{term: {"kubernetes_namespace_name.keyword": $ns}}]  else . end)
          | (if $svc != "" then .filter += [{term: {"kubernetes_container_name.keyword": $svc}}] else . end)
          | (if $lvl != "" then .filter += [{term: {"level.keyword": $lvl}}]                     else . end)
          | (if ($filters  | length) > 0 then .filter += ($filters | to_terms) else . end)
          | (if ($pfilters | length) > 0 then .filter += ($pfilters | to_phrases) else . end)
          | (if ($gtes     | length) > 0 then .filter += ($gtes | to_ranges("gte")) else . end)
          | (if ($ltes     | length) > 0 then .filter += ($ltes | to_ranges("lte")) else . end)
          | (if ($excludes | length) > 0 then .must_not = ((.must_not // []) + ($excludes | to_terms)) else . end)
          | (if ($pexcludes | length) > 0 then .must_not = ((.must_not // []) + ($pexcludes | to_phrases)) else . end)
          | (if $q      != "" then .must = ((.must // []) + [{multi_match: {query: $q,      fields: ($msg_fields | split(",")), type: "best_fields"}}]) else . end)
          | (if $phrase != "" then .must = ((.must // []) + [{multi_match: {query: $phrase, fields: ($msg_fields | split(",")), type: "phrase"}}])      else . end)
        )
      }
    }
    '
}

_active_filters_summary() {
  local parts=() kv
  if [[ -n "$AT" ]]; then parts+=("--at $AT"); else parts+=("--since $SINCE"); fi
  if [[ -n "$UNTIL" ]]; then parts+=("--until $UNTIL"); elif [[ -n "$TO" ]]; then parts+=("--to $TO"); fi
  [[ -n "$NAMESPACE" ]] && parts+=("--namespace $NAMESPACE")
  [[ -n "$SERVICE" ]] && parts+=("--service $SERVICE")
  [[ -n "$LEVEL" ]] && parts+=("--level $LEVEL")
  [[ -n "$QUERY" ]] && parts+=("--query \"$QUERY\"")
  [[ -n "$PHRASE" ]] && parts+=("--phrase \"$PHRASE\"")
  for kv in "${FILTERS[@]+"${FILTERS[@]}"}"; do parts+=("--filter $kv"); done
  for kv in "${PHRASE_FILTERS[@]+"${PHRASE_FILTERS[@]}"}"; do parts+=("--filter-phrase $kv"); done
  for kv in "${EXCLUDES[@]+"${EXCLUDES[@]}"}"; do parts+=("--exclude $kv"); done
  for kv in "${PHRASE_EXCLUDES[@]+"${PHRASE_EXCLUDES[@]}"}"; do parts+=("--exclude-phrase $kv"); done
  for kv in "${GTES[@]+"${GTES[@]}"}"; do parts+=("--gte $kv"); done
  for kv in "${LTES[@]+"${LTES[@]}"}"; do parts+=("--lte $kv"); done
  (IFS=' '; echo "${parts[*]}")
}

cmd_search() {
  local body
  # Load config before building the query: KIBANACLI_MESSAGE_FIELDS et al.
  # affect the query itself. Offline modes (--dump-query,
  # --search-response-from-file) run without config — env vars still apply.
  if [[ -z "$RESP_FILE" ]] && (( ! DUMP_QUERY )); then
    load_env
  fi
  if [[ -n "$BODY_FILE" ]]; then
    if [[ "$BODY_FILE" == "-" ]]; then
      body=$(cat)
    else
      [[ -r "$BODY_FILE" ]] || die "--body file not readable: $BODY_FILE"
      body=$(cat "$BODY_FILE")
    fi
  else
    body=$(build_query) || die "failed to build query (check --since/--to/--limit/etc.)"
  fi
  if (( DUMP_QUERY )); then
    echo "$body"
    return 0
  fi
  local bin_dir; bin_dir=$(dirname "$0")
  local respfile
  if [[ -n "$RESP_FILE" ]]; then
    respfile=$RESP_FILE
  else
    respfile=$(mktemp)
    local bodyfile; bodyfile=$(mktemp)
    echo "$body" > "$bodyfile"
    if [[ "$AUTH_MODE" == "cookie" ]]; then
      ese_search "$INDEX" "$bodyfile" > "$respfile"
    else
      proxy_request POST "${INDEX}/_search" "$bodyfile" > "$respfile"
    fi
    rm -f "$bodyfile"
  fi

  local total shown
  total=$(jq '.hits.total.value' "$respfile")
  shown=$(jq '.hits.hits | length' "$respfile")

  if (( shown == 0 )); then
    echo "[no hits for filters: $(_active_filters_summary)]"
  else
    local format_rc=0
    if [[ "$FMT" == "full" ]]; then
      MAX_LEN="$MAX_LEN" "$bin_dir/format-full.sh" < "$respfile" || format_rc=$?
    else
      jq -r -L "$bin_dir" --arg fmt "$FMT" --argjson maxlen "$MAX_LEN" -f "$bin_dir/format.jq" "$respfile" || format_rc=$?
    fi
    if (( format_rc != 0 )); then
      echo "$CLI_NAME: formatter error — falling back to JSON" >&2
      jq -c '.hits.hits[]._source' < "$respfile" || true
    elif (( total > shown )); then
      echo "[hits: $total, shown: $shown — use --limit N to see more]"
    fi
  fi

  if [[ -z "$RESP_FILE" ]]; then
    rm -f "$respfile"
  fi
}

# --- argparse ---
ACTION="search"
SINCE="1h"
TO=""
NAMESPACE="${KIBANACLI_DEFAULT_NAMESPACE:-}"
SERVICE=""
LEVEL=""
QUERY=""
INDEX="logstash-*"
LIMIT=50
MAX_LEN=1000
FMT="short"
DUMP_QUERY=0
RESP_FILE=""
FILTERS=()
EXCLUDES=()
PHRASE_FILTERS=()
PHRASE_EXCLUDES=()
GTES=()
LTES=()
BODY_FILE=""
AT=""
UNTIL=""
PHRASE=""
while (($#)); do
  case "$1" in
    --help) print_help; exit 0 ;;
    --list-indices) ACTION="list"; shift ;;
    --since) SINCE=$2; shift 2 ;;
    --to) TO=$2; shift 2 ;;
    --at) AT=$2; shift 2 ;;
    --until) UNTIL=$2; shift 2 ;;
    --namespace) NAMESPACE=$2; shift 2 ;;
    --service) SERVICE=$2; shift 2 ;;
    --level) LEVEL=$2; shift 2 ;;
    --query) QUERY=$2; shift 2 ;;
    --phrase) PHRASE=$2; shift 2 ;;
    --filter) FILTERS+=("$2"); shift 2 ;;
    --exclude) EXCLUDES+=("$2"); shift 2 ;;
    --filter-phrase) PHRASE_FILTERS+=("$2"); shift 2 ;;
    --exclude-phrase) PHRASE_EXCLUDES+=("$2"); shift 2 ;;
    --gte) GTES+=("$2"); shift 2 ;;
    --lte) LTES+=("$2"); shift 2 ;;
    --body) BODY_FILE=$2; shift 2 ;;
    --index) INDEX=$2; shift 2 ;;
    --limit) LIMIT=$2; shift 2 ;;
    --max-len) MAX_LEN=$2; shift 2 ;;
    -o) FMT=$2; shift 2 ;;
    --dump-query) DUMP_QUERY=1; shift ;;  # test-only: print query JSON and exit; see tests/run.sh
    --search-response-from-file) RESP_FILE=$2; shift 2 ;;  # test-only: read ES response from file instead of hitting network
    *) die "unknown flag: $1" ;;
  esac
done

case "$FMT" in
  short|full|json) ;;
  *) die "invalid -o value: $FMT (expected short, full, or json)" ;;
esac

case "$ACTION" in
  list)   cmd_list_indices ;;
  search) cmd_search ;;
esac
