{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-1h"
            }
          }
        },
        {
          "term": {
            "kubernetes_namespace_name.keyword": "myapp"
          }
        },
        {
          "term": {
            "user_id.keyword": "abc"
          }
        },
        {
          "term": {
            "method.keyword": "GET"
          }
        }
      ],
      "must_not": [
        {
          "term": {
            "path.keyword": "/api/health"
          }
        },
        {
          "term": {
            "user_agent.keyword": "kube-probe/1.34"
          }
        }
      ]
    }
  },
  "size": 50,
  "sort": [
    {
      "@timestamp": "desc"
    }
  ]
}
