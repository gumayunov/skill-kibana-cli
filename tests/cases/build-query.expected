{
  "size": 50,
  "sort": [{"@timestamp": "desc"}],
  "query": {
    "bool": {
      "filter": [
        {"range": {"@timestamp": {"gte": "now-2h", "lte": "now-1h"}}},
        {"term": {"kubernetes_namespace_name.keyword": "myapp"}},
        {"term": {"kubernetes_container_name.keyword": "worker"}},
        {"term": {"level.keyword": "error"}}
      ],
      "must": [
        {"simple_query_string": {"query": "task failed", "fields": ["event", "log", "message"], "default_operator": "and"}}
      ]
    }
  }
}
