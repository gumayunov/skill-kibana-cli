{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-1h"
            }
          }
        },
        {
          "term": {
            "kubernetes_namespace_name.keyword": "myapp"
          }
        },
        {
          "match_phrase": {
            "kubernetes.cluster_name": "k8s-prod01"
          }
        },
        {
          "match_phrase": {
            "kubernetes.container_name": "app"
          }
        }
      ],
      "must_not": [
        {
          "term": {
            "user_agent.keyword": "kube-probe/1.34"
          }
        },
        {
          "match_phrase": {
            "kubernetes.pod_name": "canary"
          }
        }
      ]
    }
  },
  "size": 50,
  "sort": [
    {
      "@timestamp": "desc"
    }
  ]
}
